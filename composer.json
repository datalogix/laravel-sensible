{
    "name": "datalogix/laravel-sensible",
    "description": "Laravel Sensible is a lightweight utility package for applying smart defaults and common best practices in everyday Laravel development.",
    "keywords": [
        "laravel",
        "sensible",
        "laravel-sensible",
        "defaults",
        "configuration",
        "utility"
    ],
    "homepage": "https://github.com/datalogix/laravel-sensible",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ricardo Gobbo de Souza",
            "email": "ricardogobbosouza@yahoo.com.br"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "nesbot/carbon": "^3.8.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.3.1",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6.10",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8.2|^4.4.1|^5.0.1",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Datalogix\\Sensible\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Datalogix\\Sensible\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --memory-limit=1G",
            "@php vendor/bin/rector --dry-run"
        ],
        "format": [
            "@php vendor/bin/rector",
            "@php vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Datalogix\\Sensible\\SensibleServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
