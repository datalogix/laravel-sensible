includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - config
        - src
    configDirectories:
        - config
    ignoreErrors:
        # Model::automaticallyEagerLoadRelationships() only exists since Laravel 12.8.
        -
            identifier: function.alreadyNarrowedType
            path: src/Configurables/AutomaticallyEagerLoadRelationships.php
            reportUnmatched: false
